table 'dw fact_shipments'
	lineageTag: 7e2ed4b9-d9f4-443a-8021-9f84b9276ad6

	measure 'Livraisons datées' =
			
			COUNTROWS(
			    FILTER(
			        'dw fact_shipments',
			        NOT ISBLANK('dw fact_shipments'[actual_delivery_date])
			    )
			)
		formatString: 0
		lineageTag: dda0e127-b57c-43cc-a29c-dfb909574691

	measure 'Nombre expéditions' =
			
			COUNTROWS('dw fact_shipments')
		formatString: 0
		lineageTag: 77c53e3d-c8bf-40f7-ad58-e374def5fada

	measure 'Livraisons en retard' =
			
			CALCULATE(
			    COUNTROWS('dw fact_shipments'),
			    'dw fact_shipments'[is_late] = TRUE()
			)
		formatString: 0
		lineageTag: a6cc4589-88e5-4a54-b997-ce2049bf1fad

	measure 'Taux de retard' =
			
			DIVIDE(
			    [Livraisons en retard],
			    CALCULATE(
			        COUNTROWS('dw fact_shipments'),
			        NOT ISBLANK('dw fact_shipments'[actual_delivery_date]),
			        NOT ISBLANK('dw fact_shipments'[estimated_delivery_date])
			    ),
			    0
			)
		formatString: 0.00%
		lineageTag: 40ccb7bf-6708-4a3d-981b-d47a0deb54e1

	measure 'Délai moyen livraison' =
			
			AVERAGEX(
			    FILTER(
			        'dw fact_shipments',
			        NOT ISBLANK('dw fact_shipments'[shipping_date])
			            && NOT ISBLANK('dw fact_shipments'[actual_delivery_date])
			    ),
			    DATEDIFF(
			        'dw fact_shipments'[shipping_date],
			        'dw fact_shipments'[actual_delivery_date],
			        DAY
			    )
			)
		lineageTag: f9b03776-0308-42ac-ab7b-b54de0c42b21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column shipment_key
		dataType: int64
		formatString: 0
