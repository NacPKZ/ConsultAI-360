table 'dw fact_orders'
	lineageTag: b029ba0a-5adc-49d8-b1ce-8524b62a366a

	measure 'Nombre commandes' =
			
			COUNTROWS('dw fact_orders')
		formatString: 0
		lineageTag: ffa4d483-9dac-44bc-9208-4cf5de4e5dc5

	measure 'Commandes sans montant' =
			
			COUNTROWS(
			    FILTER(
			        'dw fact_orders',
			        ISBLANK('dw fact_orders'[order_total])
			    )
			)
		formatString: 0
		lineageTag: ba8de4e4-6305-4cdd-9a8f-76f2cb6a3212

	measure 'Taux montants manquants' =
			
			DIVIDE(
			    [Commandes sans montant],
			    [Nombre commandes],
			    0
			)
		formatString: 0.00%
		lineageTag: c0d00d56-786b-440d-a71a-0f9d8a33aeaf

	measure 'CA disponible' =
			
			SUM('dw fact_orders'[order_total])
		lineageTag: 9adc0981-7ce6-4109-b4d9-d562f9da8e82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CA référence' =
			
			SUM('dbt_dev mart_revenue_impact'[original_revenue])
		formatString: #,0.0
		lineageTag: fd3a88e8-6584-4a77-8ea8-3aed8f5897eb

	measure 'Perte CA' =
			
			- SUM('dbt_dev mart_revenue_impact'[revenue_gap_eur])
		formatString: 0.00
		lineageTag: af25de53-a06c-4fb0-9d4e-2b00c7f50804

	measure 'Taux perte CA' =
			
			DIVIDE(
			    [Perte CA],
			    [CA référence],
			    0
			)
		formatString: 0.00%
		lineageTag: 327e1543-33e7-4d6d-948b-138eabc8d213

	measure 'Taux complétude montants' =
			
			1 - [Taux montants manquants]
		formatString: 0.00%
		lineageTag: 52a70e72-fbf2-4018-9f28-957178096c94

	measure 'Panier moyen commercial' =
			
			DIVIDE([CA commercial], [Commandes commerciales])
		lineageTag: 1644501a-81f4-46e4-b1e8-c5d094623dc7

	measure 'CA commercial' =
			
			SUM('dw fact_orders'[order_total])
		lineageTag: 0f73b7b5-64db-4923-89dd-b0feb8a45104

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Commandes commerciales' =
			
			DISTINCTCOUNT('dw fact_orders'[order_key])
		formatString: 0
		lineageTag: edf60403-0c88-429f-940f-9f14253d66a3

	measure 'Clients actifs commerciaux' =
			
			DISTINCTCOUNT('dw fact_orders'[customer_key])
		formatString: 0
		lineageTag: 656d356f-7eb9-4536-a811-ff430b2b24b6

	measure 'CA par client' =
			
			DIVIDE(
			    [CA commercial],
			    [Clients actifs commerciaux],
			    0
			)
		lineageTag: 211d742e-9f8f-4f8f-9087-e73c24bedb8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Part CA online' =
			
			DIVIDE(
			    CALCULATE(
			        [CA commercial],
			        'dw fact_orders'[sales_channel] = "online"
			    ),
			    CALCULATE(
			        [CA commercial],
			        REMOVEFILTERS('dw fact_orders'[sales_channel])
			    )
			)
		formatString: 0.00%
		lineageTag: cccafe29-1511-4a0b-b6f7-8e3d88cadefc

	measure 'CA commercial catégorie' =
			
			CALCULATE(
			    [CA commercial],
			    TREATAS(
			        VALUES('dw fact_sales'[order_key]),
			        'dw fact_orders'[order_key]
			    )
			)
		lineageTag: 4cea13a6-56ae-4c9f-841e-b657b132e6f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Commandes catégorie' =
			
			CALCULATE(
			    DISTINCTCOUNT('dw fact_orders'[order_key]),
			    TREATAS(
			        VALUES('dw fact_sales'[order_key]),
			        'dw fact_orders'[order_key]
			    )
			)
		formatString: 0
		lineageTag: 7f35c49f-4f59-42af-b0b2-1a9efad0aeef

	measure 'Panier moyen catégorie' =
			
			DIVIDE(
			    [CA commercial catégorie],
			    [Commandes catégorie],
			    0
			)
		lineageTag: 5a3b8429-807a-48fd-8b81-0b56d77fa14c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Clients catégorie' =
			
			CALCULATE(
			    DISTINCTCOUNT('dw fact_orders'[customer_key]),
			    TREATAS(
			        VALUES('dw fact_sales'[order_key]),
			        'dw fact_orders'[order_key]
			    )
			)
		formatString: 0
		lineageTag: b2a55a08-8f33-4b00-809b-91994b49a5bc

	measure 'CA par client catégorie' =
			
			DIVIDE(
			    [CA commercial catégorie],
			    [Clients catégorie],
			    0
			)
		lineageTag: 39db3a93-4963-4ed7-a0cd-70d303dbce07

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Part CA online catégorie' =
			
			DIVIDE(
			    CALCULATE(
			        [CA commercial catégorie],
			        'dw fact_orders'[sales_channel] = "online"
			    ),
			    CALCULATE(
			        [CA commercial catégorie],
			        REMOVEFILTERS('dw fact_orders'[sales_channel])
			    ),
			    0
			)
		formatString: 0.00%
		lineageTag: 55e45aef-bee3-4385-bec4-355816538976

	column order_key
		dataType: int64
		formatString: 0
		lineageTag: 6aa44b47-0f3f-4247-99cb-f3a27b8b1e35
		summarizeBy: none
		sourceColumn: order_key

		annotation SummarizationSetBy = Automatic

	column scenario
		dataType: string
		lineageTag: 68eed343-0e61-48f2-888e-d75fd99c9645
		summarizeBy: none
		sourceColumn: scenario

		annotation SummarizationSetBy = Automatic

	column order_id
		dataType: string
		lineageTag: ed30fb94-fb0f-4532-8abe-d193e6ed5069
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column customer_key
		dataType: int64
		formatString: 0
		lineageTag: 952a102f-5bd4-4969-9c0f-41d0514a483c
		summarizeBy: none
		sourceColumn: customer_key

		annotation SummarizationSetBy = Automatic

	column store_key
		dataType: int64
		formatString: 0
		lineageTag: 4fda7e76-ad04-4181-aefc-8819a3c1f924
		summarizeBy: none
		sourceColumn: store_key

		annotation SummarizationSetBy = Automatic

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 9157d05a-564a-4a76-acce-dafd7addc5d7
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	column sales_channel
		dataType: string
		lineageTag: e204866f-d9a5-498f-a3f7-937871523412
		summarizeBy: none
		sourceColumn: sales_channel

		annotation SummarizationSetBy = Automatic

	column order_status
		dataType: string
		lineageTag: fbe20c95-67ea-48ca-8d8d-a63a29c1491d
		summarizeBy: none
		sourceColumn: order_status

		annotation SummarizationSetBy = Automatic

	column order_total
		dataType: double
		lineageTag: 871d17ed-e5f6-448e-96e5-80d8beb95850
		summarizeBy: sum
		sourceColumn: order_total

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'dw fact_orders' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("localhost:5432", "nexaretail_db"),
				    dw_fact_orders = Source{[Schema="dw",Item="fact_orders"]}[Data]
				in
				    dw_fact_orders

	annotation PBI_ResultType = Table

