table DimScenario
	lineageTag: 92993b78-5303-40eb-986d-805189bd4c70

	measure 'CA référence ROI' =
			
			SUM('dbt_dev mart_revenue_impact'[original_revenue])
		lineageTag: d301aee2-c1e6-4565-8dfc-bf96ab981e8c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CA observé ROI' =
			
			SUM('dbt_dev mart_revenue_impact'[observed_revenue])
		lineageTag: 8103e536-15f0-4235-b556-75000f64f965

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Écart CA ROI' =
			
			[CA référence ROI] - [CA observé ROI]
		lineageTag: a6d22738-7b34-4205-882d-f024f407b909

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Taux écart CA ROI' =
			
			DIVIDE(
			    [Écart CA ROI],
			    [CA référence ROI]
			)
		lineageTag: 24ad171e-5c6a-446f-a650-cdc98fc221aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column scenario
		lineageTag: 8de8db46-4117-414b-880d-43023e840116
		summarizeBy: none
		isNameInferred
		sourceColumn: [scenario]

		annotation SummarizationSetBy = Automatic

	column ordre
		formatString: 0
		lineageTag: 9998432d-5b36-4216-87b4-d5d222975978
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ordre]

		annotation SummarizationSetBy = Automatic

	hierarchy 'scenario Hiérarchie'
		lineageTag: 143adb53-4b3f-47f0-9a64-15960ad1ba22

		level scenario
			lineageTag: 44c08226-a3d2-424b-8088-4b7cc659ee0f
			column: scenario

	partition DimScenario = calculated
		mode: import
		source =
				
				DATATABLE(
				    "scenario", STRING,
				    "ordre", INTEGER,
				    {
				        {"low", 1},
				        {"medium", 2},
				        {"critical", 3}
				    }
				)

	annotation PBI_Id = 9648534e875846c3a2d2129b47a20423

