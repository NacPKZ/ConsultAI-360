table ML_Metrics
	lineageTag: f6ed3398-91ab-4e75-9ac0-adc346e30c51

	measure 'ROI Coefficient' = ```
			
			SELECTEDVALUE(
			    ROI_Scenarios[Coefficient],
			    1
			)
			
			```
		lineageTag: e36a4595-8dff-4dc3-860e-24145c5e044b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ROI Investissement' = ```
			
			50000
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 851cabaf-b01a-4eee-9c91-946dfc1000b6

	measure 'ROI Gain annuel' = ```
			
			SUM(ROI_Leviers[GainAnnuelBase])
			    * [ROI Coefficient]
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 5b6bb395-59d7-42e6-bfbc-4701d7905c5e

	measure 'ROI Gain net' = ```
			
			[ROI Gain annuel] - [ROI Investissement]
			
			```
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		lineageTag: 04d6b00c-895d-432d-823c-2d99fa90e202

	measure 'ROI Pourcentage' = ```
			
			DIVIDE(
			    [ROI Gain net],
			    [ROI Investissement]
			)
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 96076b68-2885-4461-bc81-a2a324253748

	measure 'ROI Gains cumulés' = ```
			
			[ROI Gain annuel]
			    * DIVIDE(
			        MAX(ROI_Mois[Value]),
			        12
			    )
			
			```
		lineageTag: 28218782-294e-43ce-9b06-05cb15247078

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ROI Seuil rentabilité mois' = ```
			
			DIVIDE(
			    [ROI Investissement],
			    [ROI Gain annuel]
			) * 12
			
			```
		lineageTag: 69f7f84e-3379-4910-8c25-54deb945e8ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ROI Gain par levier' = ```
			
			SUM(ROI_Leviers[GainAnnuelBase])
			    * [ROI Coefficient]
			
			```
		lineageTag: 768f414f-90f6-4302-895e-2dc5cc272696

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ROI Analyse Business' = ```
			
			VAR Scenario =
			    SELECTEDVALUE(
			        ROI_Scenarios[Scenario],
			        "Central"
			    )
			
			VAR Analyse =
			    SWITCH(
			        Scenario,
			        "Prudent",
			        "Rentabilité positive mais marge de sécurité limitée. Un déploiement progressif est recommandé.",
			
			        "Central",
			        "Potentiel financier intéressant. Les gains reposent principalement sur la logistique et la qualité des données. Un pilote opérationnel est recommandé.",
			
			        "Optimiste",
			        "Potentiel de rentabilité élevé, sous réserve de confirmer les hypothèses ambitieuses de gains.",
			
			        "Scénario non défini."
			    )
			
			RETURN
			    "Diagnostic Financier : " & UNICHAR(10) &
			    Analyse & UNICHAR(10) & UNICHAR(10) &
			    "ROI net estimé : " &
			    FORMAT([ROI Pourcentage], "0.0%") &
			    UNICHAR(10) &
			    "Retour sur investissement : " &
			    FORMAT([ROI Seuil rentabilité mois], "0.0") &
			    " mois" & UNICHAR(10) & UNICHAR(10) &
			    "Limite : résultats simulés, non observés."
			
			```
		lineageTag: 8675d60a-caf6-4fbd-bf97-0d3cc00e1ce7

