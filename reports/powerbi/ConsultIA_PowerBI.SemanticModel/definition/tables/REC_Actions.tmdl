table REC_Actions
	lineageTag: 973c0490-3a0d-4924-b6d4-4f9eeec0dfda

	measure 'REC Nombre actions' = ```
			
			COUNTROWS(REC_Actions)
			
			```
		formatString: 0
		lineageTag: 73ed374a-a2ca-4514-b688-8f557f0e8325

	measure 'REC Actions prioritaires' = ```
			
			CALCULATE(
			    COUNTROWS(REC_Actions),
			    REC_Actions[Priorite] <= 2
			)
			
			```
		formatString: 0
		lineageTag: c0086587-46c0-459d-917f-2b646103cb3e

	measure 'REC Horizon' = ```
			
			"90 jours"
			
			```
		lineageTag: cb5577af-619d-4bf8-9e0d-1423ff2333a0

	measure 'REC Diagnostic' = ```
			
			VAR Scenario =
			    SELECTEDVALUE(
			        ROI_Scenarios[Scenario],
			        "Central"
			    )
			RETURN
			SWITCH(
			    Scenario,
			    "Prudent",
			        "Décision : déploiement progressif. 
			         Prioriser la réduction des retards et la qualité des données avant d'engager des investissements supplémentaires.",
			    "Central",
			        "Décision : lancer un pilote de 90 jours. 
			         Mesurer les gains logistiques, 
			         la fiabilité des alertes et les coûts réels avant généralisation.",
			    "Optimiste",
			        "Décision : tester les hypothèses de gains élevés. 
			         Ne pas engager un déploiement complet sans validation opérationnelle et financière.",
			    "Décision : sélectionner un scénario financier."
			)
			
			```
		lineageTag: 3af58d16-ac29-4d9c-bfec-8a9de1080387

