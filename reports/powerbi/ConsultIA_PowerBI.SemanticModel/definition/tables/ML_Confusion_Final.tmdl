		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ML_Confusion_Final = calculated
		mode: import
		source =
				
				UNION(
				    ROW(
				        "Réel", "Pas de retard",
				        "Prédit", "Pas de retard",
				        "Nombre", CALCULATE(MAX(ML_Metrics[tn]), ML_Metrics[model] = "random_forest")
				    ),
				    ROW(
				        "Réel", "Pas de retard",
				        "Prédit", "Retard",
				        "Nombre", CALCULATE(MAX(ML_Metrics[fp]), ML_Metrics[model] = "random_forest")
				    ),
				    ROW(
				        "Réel", "Retard",
				        "Prédit", "Pas de retard",
				        "Nombre", CALCULATE(MAX(ML_Metrics[fn]), ML_Metrics[model] = "random_forest")
				    ),
				    ROW(
				        "Réel", "Retard",
				        "Prédit", "Retard",
				        "Nombre", CALCULATE(MAX(ML_Metrics[tp]), ML_Metrics[model] = "random_forest")
				    )
				)

	annotation PBI_Id = f29d1691927747dc9f4f14a8074e4f37

